#set($inputRoot = $input.path('$'))
{
  "seekerId": "$context.authorizer.claims['custom:userId']",
  "cloudFrontRequestId": "$util.escapeJavaScript($input.params('X-Amz-Cf-Id')).replaceAll("\\'","'")",
  "apiGwRequestId": "$context.requestId",
  "requestPostId": "$util.escapeJavaScript($inputRoot.requestPostId).replaceAll("\\'","'")",
  "requestCreatedAt": "$util.escapeJavaScript($inputRoot.requestCreatedAt).replaceAll("\\'","'")"
}
