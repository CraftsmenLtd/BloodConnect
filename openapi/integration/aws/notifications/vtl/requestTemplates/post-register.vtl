#set($inputRoot = $input.path('$'))
{
  "userId": "$context.authorizer.claims['custom:userId']",
  "cloudFrontRequestId": "$util.escapeJavaScript($input.params('X-Amz-Cf-Id')).replaceAll("\\'","'")",
  "apiGwRequestId": "$context.requestId",
  "deviceToken": "$util.escapeJavaScript($inputRoot.deviceToken).replaceAll("\\'","'")",
  "platform": "$util.escapeJavaScript($inputRoot.platform).replaceAll("\\'","'")"
}